# Free key from https://aistudio.google.com

# Used by the API (and docker compose) for escalations and reply drafts
TRIAGE_LLM_API_KEY=
TRIAGE_LLM_MODEL=gemini-3.5-flash-lite

# Used by ml/src/label.py, the teacher that labels training data.
# Any OpenAI-compatible endpoint works.
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LABEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LABEL_API_KEY=
LABEL_MODEL=gemini-3.5-flash-lite
# optional, cuts latency on thinking models; leave empty for flash-lite
LABEL_REASONING=
